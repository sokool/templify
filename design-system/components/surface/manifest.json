{
  "name": "surface",
  "version": "0.1.0",
  "status": "extracted",
  "entry": "surface.js",
  "stylesheet": "surface.css",
  "global": "DesignSystemSurface",
  "runtimeFiles": [
    "surface.js",
    "surface.css"
  ],
  "exportFiles": [
    "surface.js",
    "surface.css",
    "../../foundations/tokens.css",
    "../../foundations/primitives.css"
  ],
  "dependencies": {
    "components": [],
    "packages": [],
    "foundations": [
      "../../foundations/tokens.css",
      "../../foundations/primitives.css"
    ],
    "platform": [
      "DOM",
      "CSS custom properties"
    ]
  },
  "integration": {
    "lifecycle": [
      "mount(element, options)",
      "update(options)",
      "destroy()"
    ],
    "persistence": "Caller-owned; no runtime localStorage",
    "content": "Plain strings or explicit DOM Nodes; no HTML string evaluation",
    "data": "Existing children are preserved. Optional `content: string | Node`, `bg`, `text`, `border`, numeric `radius`, `padding`, `borderWidth`, and `shadow: none | soft | raised`.",
    "api": "`mount(element, options)` \u2192 `update(options)`, `destroy()`. Destroy restores pre-existing inline tokens and keeps content. `defaults`, `tokens` and `shadows` describe the public appearance contract; they do not load an editor."
  },
  "excluded": [
    "tool.js",
    "tool.css",
    "examples",
    "tests"
  ],
  "tests": "node --test tests/*.test.cjs",
  "tool": {
    "entry": "tool.js",
    "stylesheet": "tool.css",
    "developmentOnly": true,
    "export": false,
    "hostHelper": "../../appearance/appearance.js"
  },
  "example": "../../examples/index.html#topschrank.components.surface",
  "publicTokens": [
    "--ds-surface-bg",
    "--ds-surface-text",
    "--ds-surface-border",
    "--ds-surface-radius",
    "--ds-surface-padding",
    "--ds-surface-border-width",
    "--ds-surface-shadow"
  ]
}
